{
  "name": "toolkit",
  "displayName": "Toolkit",
  "description": "Developer utilities for VS Code",
  "version": "1.8.4",
  "license": "MIT",
  "publisher": "huanent",
  "icon": "resources/logo.png",
  "homepage": "https://github.com/huanent/vscode-toolkit.git",
  "repository": {
    "type": "github",
    "url": "https://github.com/huanent/vscode-toolkit"
  },
  "extensionKind": [
    "ui"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onDebugAdapterProtocolTracker",
    "onFileSystem:toolkit-temp",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscode-toolkit.archiveEditor",
        "displayName": "Archive",
        "selector": [
          {
            "filenamePattern": "*.zip"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscode-toolkit.excelEditor",
        "displayName": "Excel",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscode-toolkit.database.sqliteEditor",
        "displayName": "SQLite",
        "selector": [
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.sqlite3"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "vscode-toolkit.chatEditor",
        "displayName": "Chat",
        "selector": [
          {
            "filenamePattern": "*.chat"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "vscode-toolkit.explorerEditor",
        "displayName": "Explorer",
        "selector": [
          {
            "filenamePattern": "*.explorer"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "vscode-toolkit.ssh.editor",
        "displayName": "SSH",
        "selector": [
          {
            "filenamePattern": "*.ssh"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "vscode-toolkit.database.editor",
        "displayName": "Database",
        "selector": [
          {
            "filenamePattern": "*.database"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "vscode-toolkit.container.editor",
        "displayName": "Container",
        "selector": [
          {
            "filenamePattern": "*.container"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ],
        "configuration": "./resources/http/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "http",
        "scopeName": "source.http",
        "path": "./resources/http/http.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-toolkit-dashboard",
          "title": "Toolkit",
          "icon": "$(tools)"
        }
      ],
      "panel": [
        {
          "id": "vscode-toolkit-result",
          "title": "Result",
          "icon": "$(output)"
        }
      ]
    },
    "views": {
      "vscode-toolkit-dashboard": [
        {
          "id": "vscode-toolkit.dashboard",
          "name": "Toolkit",
          "type": "webview",
          "icon": "$(tools)"
        }
      ],
      "vscode-toolkit-result": [
        {
          "id": "vscode-toolkit.result",
          "name": "Result",
          "type": "webview",
          "icon": "$(output)"
        }
      ]
    },
    "submenus": [
      {
        "id": "vscode-toolkit.sourceControl",
        "label": "Source Control"
      }
    ],
    "commands": [
      {
        "command": "vscode-toolkit.dashboard.edit",
        "title": "Edit"
      },
      {
        "command": "vscode-toolkit.dashboard.duplicate",
        "title": "Duplicate"
      },
      {
        "command": "vscode-toolkit.dashboard.copyHost",
        "title": "Copy Host"
      },
      {
        "command": "vscode-toolkit.dashboard.runScript",
        "title": "Run Script"
      },
      {
        "command": "vscode-toolkit.dashboard.up",
        "title": "Move Up",
        "enablement": "!dashboardFiltered"
      },
      {
        "command": "vscode-toolkit.dashboard.down",
        "title": "Move Down",
        "enablement": "!dashboardFiltered"
      },
      {
        "command": "vscode-toolkit.dashboard.export",
        "title": "Export"
      },
      {
        "command": "vscode-toolkit.dashboard.delete",
        "title": "Delete"
      },
      {
        "command": "vscode-toolkit.dashboard.groupUp",
        "title": "Move Up",
        "enablement": "!dashboardFiltered && !dashboardGroupFirst"
      },
      {
        "command": "vscode-toolkit.dashboard.groupDown",
        "title": "Move Down",
        "enablement": "!dashboardFiltered && !dashboardGroupLast"
      },
      {
        "command": "vscode-toolkit.dashboard.groupRename",
        "title": "Rename"
      },
      {
        "command": "vscode-toolkit.temp.newFile",
        "title": "New Temp File",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.temp.delete",
        "title": "Delete",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.temp.selectFolder",
        "title": "Select Folder...",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.dashboard.groupDelete",
        "title": "Delete"
      },
      {
        "command": "vscode-toolkit.editWorkflow",
        "title": "Edit"
      },
      {
        "command": "vscode-toolkit.deleteWorkflow",
        "title": "Delete"
      },
      {
        "command": "vscode-toolkit.openDashboard",
        "title": "Open Dashboard",
        "icon": "$(tools)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.openWorkflow",
        "title": "Open Workflow",
        "icon": "$(list-ordered)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.generateGitignore",
        "title": "Generate .gitignore",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.sendHttpRequest",
        "title": "Send HTTP Request",
        "icon": "$(play)",
        "category": "Toolkit",
        "enablement": "editorLangId == http && isWorkspaceTrusted"
      },
      {
        "command": "vscode-toolkit.runDotnetScript",
        "title": "Run dotnet Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.runShScript",
        "title": "Run sh Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.runBatScript",
        "title": "Run bat Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.runNodeScript",
        "title": "Run node Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.runBunScript",
        "title": "Run bun Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.runNpmScript",
        "title": "Run package.json Script",
        "icon": "$(terminal)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.runBunPackageScript",
        "title": "Run package.json Script",
        "icon": "$(terminal)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.pullGitRepository",
        "title": "Pull",
        "icon": "$(cloud-download)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.pushGitRepository",
        "title": "Push",
        "icon": "$(cloud-upload)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.fetchGitRepository",
        "title": "Fetch",
        "icon": "$(sync)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.checkoutGitRepository",
        "title": "Checkout to...",
        "icon": "$(git-branch)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.openChat",
        "title": "Open Chat",
        "icon": "$(comment-discussion)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.openCredential",
        "title": "Open Credential",
        "icon": "$(key)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.newChat",
        "title": "New Chat",
        "category": "Toolkit",
        "icon": "$(add)"
      },
      {
        "command": "vscode-toolkit.newChatTab",
        "title": "New Chat Tab",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.openExplorer",
        "title": "Open in Explorer",
        "icon": "$(folder)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.openExplorerTab",
        "title": "Open Explorer Tab",
        "category": "Toolkit"
      },
      {
        "command": "editor.foldAll",
        "title": "Fold All",
        "icon": "$(fold-all)"
      },
      {
        "command": "vscode-toolkit.servers.openSftp",
        "title": "Open SFTP",
        "icon": "$(folder)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.servers.runSshCommand",
        "title": "Run Script",
        "icon": "$(three-bars)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.servers.executeMysqlSql",
        "title": "Execute SQL",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.servers.exportMysqlSqlResults",
        "title": "Export SQL Results",
        "icon": "$(cloud-download)",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.openSSH",
        "title": "Open SSH",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.openDatabase",
        "title": "Open Database",
        "category": "Toolkit"
      },
      {
        "command": "vscode-toolkit.openContainer",
        "title": "Open Container",
        "category": "Toolkit"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "vscode-toolkit.temp.delete",
          "when": "webviewId == 'vscode-toolkit.dashboard' && (webviewSection == 'tempFile' || webviewSection == 'tempFolder')",
          "group": "temp@2"
        },
        {
          "command": "vscode-toolkit.temp.selectFolder",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'tempFile'",
          "group": "temp@1"
        },
        {
          "command": "vscode-toolkit.dashboard.edit",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'connectionItem'",
          "group": "connection@1"
        },
        {
          "command": "vscode-toolkit.dashboard.duplicate",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'connectionItem'",
          "group": "connection@2"
        },
        {
          "command": "vscode-toolkit.dashboard.copyHost",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'connectionItem' && dashboardTab != 'container'",
          "group": "connection@3"
        },
        {
          "command": "vscode-toolkit.dashboard.runScript",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'connectionItem' && dashboardTab == 'ssh' && dashboardHasScripts",
          "group": "connection@4"
        },
        {
          "command": "vscode-toolkit.dashboard.up",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'connectionItem'",
          "group": "connection@5"
        },
        {
          "command": "vscode-toolkit.dashboard.down",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'connectionItem'",
          "group": "connection@6"
        },
        {
          "command": "vscode-toolkit.dashboard.export",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'connectionItem'",
          "group": "connection@7"
        },
        {
          "command": "vscode-toolkit.dashboard.delete",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'connectionItem'",
          "group": "connection@8"
        },
        {
          "command": "vscode-toolkit.dashboard.groupUp",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'sshGroup'",
          "group": "group@1"
        },
        {
          "command": "vscode-toolkit.dashboard.groupDown",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'sshGroup'",
          "group": "group@2"
        },
        {
          "command": "vscode-toolkit.dashboard.groupRename",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'sshGroup'",
          "group": "group@3"
        },
        {
          "command": "vscode-toolkit.dashboard.groupDelete",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'sshGroup'",
          "group": "group@4"
        },
        {
          "command": "vscode-toolkit.editWorkflow",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'workflowItem'",
          "group": "workflow@1"
        },
        {
          "command": "vscode-toolkit.deleteWorkflow",
          "when": "webviewId == 'vscode-toolkit.dashboard' && webviewSection == 'workflowItem'",
          "group": "workflow@2"
        }
      ],
      "view/title": [
        {
          "command": "vscode-toolkit.openCredential",
          "when": "view == vscode-toolkit.dashboard",
          "group": "navigation@3"
        },
        {
          "command": "vscode-toolkit.openExplorer",
          "when": "view == vscode-toolkit.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "vscode-toolkit.openChat",
          "when": "view == vscode-toolkit.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "vscode-toolkit.servers.exportMysqlSqlResults",
          "when": "view == vscode-toolkit.result && vscode-toolkit.servers.mysqlSqlResultsExportable",
          "group": "navigation@9999"
        }
      ],
      "editor/title": [
        {
          "command": "editor.foldAll",
          "when": "activeEditor == workbench.editors.textEditor",
          "group": "navigation@8"
        },
        {
          "command": "vscode-toolkit.newChat",
          "when": "activeCustomEditorId == vscode-toolkit.chatEditor",
          "group": "navigation"
        },
        {
          "command": "vscode-toolkit.servers.executeMysqlSql",
          "when": "editorLangId == sql && vscode-toolkit.servers.mysqlSqlEditorActive",
          "group": "navigation@1"
        },
        {
          "command": "vscode-toolkit.servers.runSshCommand",
          "when": "activeWebviewPanelId == vscode-toolkit.ssh.editor && resourceFilename == sshTerminal.ssh && vscode-toolkit.servers.activeSshHasCommands",
          "group": "navigation@1"
        },
        {
          "command": "vscode-toolkit.servers.openSftp",
          "when": "activeWebviewPanelId == vscode-toolkit.ssh.editor && resourceFilename == sshTerminal.ssh",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "vscode-toolkit.sourceControl",
          "when": "explorerResourceIsFolder && resourcePath in vscode-toolkit.gitRepositoryFolders",
          "group": "navigation@9"
        },
        {
          "command": "vscode-toolkit.runDotnetScript",
          "when": "resourceExtname == .cs",
          "group": "navigation@10"
        },
        {
          "command": "vscode-toolkit.runShScript",
          "when": "resourceExtname == .sh && !isWindows",
          "group": "navigation@10"
        },
        {
          "command": "vscode-toolkit.runBatScript",
          "when": "resourceExtname == .bat && isWindows",
          "group": "navigation@10"
        },
        {
          "command": "vscode-toolkit.runNodeScript",
          "when": "(resourceLangId == javascript || resourceLangId == typescript) && vscode-toolkit.nodeAvailable && !vscode-toolkit.bunWorkspace",
          "group": "navigation@10"
        },
        {
          "command": "vscode-toolkit.runBunScript",
          "when": "(resourceLangId == javascript || resourceLangId == typescript) && vscode-toolkit.bunAvailable && vscode-toolkit.bunWorkspace",
          "group": "navigation@10"
        },
        {
          "command": "vscode-toolkit.runNpmScript",
          "when": "explorerResourceIsFolder && vscode-toolkit.npmAvailable && resourcePath in vscode-toolkit.npmScriptFolders",
          "group": "navigation@12"
        },
        {
          "command": "vscode-toolkit.runBunPackageScript",
          "when": "explorerResourceIsFolder && vscode-toolkit.bunAvailable && resourcePath in vscode-toolkit.bunScriptFolders",
          "group": "navigation@12"
        },
        {
          "command": "vscode-toolkit.openExplorer",
          "group": "navigation@999"
        }
      ],
      "vscode-toolkit.sourceControl": [
        {
          "command": "vscode-toolkit.pullGitRepository",
          "group": "1_remote@1"
        },
        {
          "command": "vscode-toolkit.pushGitRepository",
          "group": "1_remote@2"
        },
        {
          "command": "vscode-toolkit.fetchGitRepository",
          "group": "1_remote@3"
        },
        {
          "command": "vscode-toolkit.checkoutGitRepository",
          "group": "2_local@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vscode-toolkit.temp.delete",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.temp.selectFolder",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.edit",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.duplicate",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.copyHost",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.runScript",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.up",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.down",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.export",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.delete",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.groupUp",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.groupDown",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.groupRename",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.dashboard.groupDelete",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.editWorkflow",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.deleteWorkflow",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.runNodeScript",
          "when": "vscode-toolkit.nodeAvailable && !vscode-toolkit.bunWorkspace"
        },
        {
          "command": "vscode-toolkit.runBunScript",
          "when": "vscode-toolkit.bunAvailable && vscode-toolkit.bunWorkspace"
        },
        {
          "command": "vscode-toolkit.runNpmScript",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.runBunPackageScript",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.pullGitRepository",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.pushGitRepository",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.fetchGitRepository",
          "when": "false"
        },
        {
          "command": "vscode-toolkit.checkoutGitRepository",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vscode-toolkit.temp.newFile",
        "key": "ctrl+shift+,",
        "mac": "cmd+shift+,"
      },
      {
        "command": "vscode-toolkit.openDashboard",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+."
      },
      {
        "command": "vscode-toolkit.openChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "!vscode-toolkit.chatWebviewFocus"
      },
      {
        "command": "vscode-toolkit.newChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "activeCustomEditorId == vscode-toolkit.chatEditor && vscode-toolkit.chatWebviewFocus"
      },
      {
        "command": "vscode-toolkit.newChatTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeCustomEditorId == vscode-toolkit.chatEditor && vscode-toolkit.chatWebviewFocus"
      },
      {
        "command": "vscode-toolkit.openExplorer",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      },
      {
        "command": "vscode-toolkit.openExplorerTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeCustomEditorId == vscode-toolkit.explorerEditor && vscode-toolkit.explorerWebviewFocus"
      },
      {
        "command": "vscode-toolkit.servers.executeMysqlSql",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == sql && vscode-toolkit.servers.mysqlSqlEditorActive"
      }
    ],
    "configuration": {
      "title": "Toolkit",
      "properties": {
        "toolkit.perftips.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show debug interval annotations while debugging. Changes apply to new debug sessions.",
          "scope": "window"
        },
        "toolkit.storagePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Toolkit data directory. Supports `~`. Defaults to extension global storage.",
          "scope": "machine"
        },
        "toolkit.chat.prompt": {
          "type": "string",
          "default": "",
          "markdownDescription": "The prompt used for chats.",
          "scope": "window"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "readConfigrations",
        "toolReferenceName": "readConfigrations",
        "displayName": "Read Configurations",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Read saved configurations as a JSON array, optionally filtered by type, exact ID, and regular expression. Credentials include metadata only, never secrets.",
        "inputSchema": {
          "type": "object",
          "properties": {
