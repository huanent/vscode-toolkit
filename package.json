      "explorer/context": [
        {
          "command": "toolkit.explorer.openInExplorer",
          "group": "navigation@8"
        },
        {
          "submenu": "toolkit.sourceControl",
          "when": "explorerResourceIsFolder && resourcePath in toolkit.gitRepositoryFolders",
          "group": "navigation@9"
        },
        {
          "command": "toolkit.runDotnetScript",
          "when": "resourceExtname == .cs",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runShScript",
          "when": "resourceExtname == .sh && !isWindows",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runBatScript",
          "when": "resourceExtname == .bat && isWindows",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runNodeScript",
          "when": "(resourceLangId == javascript || resourceLangId == typescript) && toolkit.nodeAvailable && !toolkit.bunWorkspace",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runBunScript",
          "when": "(resourceLangId == javascript || resourceLangId == typescript) && toolkit.bunAvailable && toolkit.bunWorkspace",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runNpmScript",
          "when": "explorerResourceIsFolder && toolkit.npmAvailable && resourcePath in toolkit.npmScriptFolders",
          "group": "navigation@12"
        },
        {
          "command": "toolkit.runBunPackageScript",
          "when": "explorerResourceIsFolder && toolkit.bunAvailable && resourcePath in toolkit.bunScriptFolders",
          "group": "navigation@12"
        }
