          "command": "toolkit.pushGitRepository",
          "group": "1_remote@2"
        },
        {
          "command": "toolkit.fetchGitRepository",
          "group": "1_remote@3"
        },
        {
          "command": "toolkit.statusGitRepository",
          "group": "1_remote@4"
        },
        {
          "command": "toolkit.checkoutGitRepository",
          "group": "2_local@1"
        }
      ]
