{
  "name": "toolkit",
  "displayName": "Toolkit",
  "version": "2.1.0",
  "description": "HTTP requests, databases, SSH, file previews, and workflow automation, with Copilot integration. All in VS Code.",
  "categories": [
    "Other"
  ],
  "homepage": "https://github.com/huanent/vscode-toolkit.git",
  "license": "MIT",
  "repository": {
    "type": "github",
    "url": "https://github.com/huanent/vscode-toolkit"
  },
  "publisher": "huanent",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run validate && npm run build:production",
    "compile": "npm run validate && VITE_BUILD_TARGET=extension vite build --mode development && VITE_BUILD_TARGET=webview vite build --mode development",
    "build:production": "VITE_BUILD_TARGET=extension vite build --mode production && VITE_BUILD_TARGET=webview vite build --mode production",
    "dev-install": "mkdir -p packages && vsce package --out packages/toolkit-$npm_package_version.vsix && code --install-extension packages/toolkit-$npm_package_version.vsix --force",
    "publish": "vsce publish",
    "format": "oxfmt .",
    "check-types": "npm run check-types:host && npm run check-types:webview",
    "check-types:host": "tsc --noEmit -p tsconfig.host.json",
    "check-types:webview": "tsc --noEmit -p tsconfig.webview.json",
    "lint": "oxlint src",
    "validate": "npm run check-types && npm run lint"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.x",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.125.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/vsce": "^4.0.0",
    "cn": "^0.4.0",
    "exceljs": "^4.4.0",
    "mysql2": "^3.24.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "xml-formatter": "^3.7.0",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "contributes": {
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ],
        "mimetypes": [
          "message/http",
          "application/http"
        ],
        "firstLine": "^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|CONNECT|TRACE)\\s+(.*?)HTTP/[0-9\\.]+$",
        "configuration": "./languages/http-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "http",
        "scopeName": "source.http",
        "path": "./syntaxes/http.tmLanguage.json",
        "embeddedLanguages": {
          "source.json": "json",
          "text.xml": "xml"
        }
      }
    ],
    "snippets": [
      {
        "language": "http",
        "path": "./snippets/http.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "toolkit.archiveEditor",
        "displayName": "Archive",
        "selector": [
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.vsix"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.spreadsheetEditor",
        "displayName": "Spreadsheet",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.sqliteEditor",
        "displayName": "SQLite Database",
        "selector": [
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.sqlite"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.sqliteTableEditor",
        "displayName": "SQLite Table",
        "selector": [
          {
            "filenamePattern": "*.sqlite-table"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.mysqlEditor",
        "displayName": "MySQL Database",
        "selector": [
          {
            "filenamePattern": "*.mysql"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.mysqlTableEditor",
        "displayName": "MySQL Table",
        "selector": [
          {
            "filenamePattern": "*.mysql-table"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.workflowEditor",
        "displayName": "Workflow",
        "selector": [
          {
            "filenamePattern": "*.workflow"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "toolkit_dashboard",
          "title": "Toolkit",
          "icon": "resource/logo.svg"
        }
      ],
      "panel": [
        {
          "id": "toolkit_result",
          "title": "Result",
          "icon": "$(run-with-deps)"
        }
      ]
    },
    "views": {
      "toolkit_dashboard": [
        {
          "type": "webview",
          "id": "toolkit.dashboard",
          "name": "Toolkit",
          "icon": "resource/logo.svg"
        }
      ],
      "toolkit_result": [
        {
          "type": "webview",
          "id": "toolkit.result",
          "name": "Result",
          "icon": "$(run-with-deps)"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "assetsSearch",
        "displayName": "Search Assets",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "assetsSearch",
        "modelDescription": "Search saved Toolkit assets by keyword. Types: 'ssh' (sshExecute, sftpTransfer), 'mysql' and 'postgresql' (sqlExecute), 'httpClient' (httpClientExecute). Returns id, type, name, description, folder and connection metadata. Secrets are never returned.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "keyword": {
              "type": "string",
              "description": "Keyword to match against asset names, descriptions, IDs, types, folders, hosts, ports, database names, and base URLs."
            }
          },
          "required": [
            "keyword"
          ]
        }
      },
      {
        "name": "httpClientExecute",
        "displayName": "Send HTTP Client Request",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "httpClientExecute",
        "modelDescription": "Send an HTTP request using a saved httpClient asset's base URL, default headers and authentication. Returns response status, headers, body and timing. Redirects are rejected.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "HTTP client asset ID or unique ID prefix."
            },
            "path": {
              "type": "string",
              "description": "Relative path appended to the base URL directory, or a root-relative path. Must resolve to the same origin."
            },
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "HEAD",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "OPTIONS"
              ],
              "description": "HTTP method. Defaults to GET."
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Additional headers, overriding defaults. Configured authentication takes precedence."
            },
            "query": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Query parameters."
            },
            "body": {
              "type": "string",
              "description": "Request body. Set Content-Type explicitly when sending JSON."
            }
          },
          "required": [
            "id",
            "path"
          ]
        }
      },
      {
        "name": "sshExecute",
        "displayName": "Run SSH Command",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sshExecute",
        "modelDescription": "Run a command on an SSH asset by its ID. Requires user confirmation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "SSH asset ID or unique ID prefix."
            },
            "command": {
              "type": "string",
              "description": "Remote shell command to execute."
            }
          },
          "required": [
            "id",
            "command"
          ]
        }
      },
      {
        "name": "sftpTransfer",
        "displayName": "Transfer SFTP File",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sftpTransfer",
        "modelDescription": "Upload or download a file through an SSH asset by its ID. Requires user confirmation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "SSH asset ID or unique ID prefix."
            },
            "direction": {
              "type": "string",
              "enum": [
                "upload",
                "download"
              ],
              "description": "Transfer direction."
            },
            "localPath": {
              "type": "string",
              "description": "Absolute local file path."
            },
            "remotePath": {
              "type": "string",
              "description": "Remote file path."
            }
          },
          "required": [
            "id",
            "direction",
            "localPath",
            "remotePath"
          ]
        }
      },
      {
        "name": "sqlExecute",
        "displayName": "Execute SQL",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sqlExecute",
        "modelDescription": "Execute one SQL statement against a MySQL or PostgreSQL database asset by its ID.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Database asset ID or unique ID prefix."
            },
            "database": {
              "type": "string",
              "description": "Optional database name; defaults to the asset's configured database."
            },
            "sql": {
              "type": "string",
              "description": "Single SQL statement to execute."
            }
          },
          "required": [
            "id",
            "sql"
          ]
        }
      },
      {
        "name": "workflowSearch",
        "displayName": "Search Workflows",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "workflowSearch",
        "modelDescription": "Search saved workflows by keyword matching name, description, ID, or folder. Returns IDs, descriptions, folders, storage scopes, step counts, and step types. Use an empty keyword to list all workflows.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "keyword": {
              "type": "string",
              "description": "Case-insensitive keyword, or empty to list all workflows."
            }
          },
          "required": [
            "keyword"
          ]
        }
      },
      {
        "name": "workflowRun",
        "displayName": "Run Workflow",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "workflowRun",
        "modelDescription": "Run a saved workflow by ID and wait for completion. Returns success, message, and output. Steps run in order and stop at the first failure. SSH assets must allow AI access.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Workflow ID returned by workflowSearch or workflowUpsert."
            }
          },
          "required": [
            "id"
          ]
        }
      },
      {
        "name": "workflowUpsert",
        "displayName": "Create or Update Workflow",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "workflowUpsert",
        "modelDescription": "Create a saved workflow from ordered steps, or update an existing one when id is given. Steps run in order and stop at the first failure. Local command cwd and command, and sftp localPath, support placeholders: ${workspaceFolder}, ${workspaceFolderBasename}, ${userHome}, ${pathSeparator}, ${env:NAME}. Returns the workflow ID and whether it was created or updated.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Existing workflow ID to update. Omit to create a new workflow."
            },
            "name": {
              "type": "string",
              "description": "Workflow name."
            },
            "folderId": {
              "type": "string",
              "description": "Optional destination folder ID for new workflows. Ignored when updating."
            },
            "storageScope": {
              "type": "string",
              "enum": [
                "global",
                "workspace"
              ],
              "description": "Storage location. Omit to use global for new workflows or preserve the existing location when updating. Specifying a different location moves the workflow. Workspace storage requires an open workspace folder."
            },
            "description": {
              "type": "string",
              "description": "Workflow description. Omit to preserve the existing description; use an empty string to clear it."
            },
            "environment": {
              "type": "array",
              "description": "Variable definitions for the workflow run form. Omit to preserve existing variables; use [] to clear them. Provided arrays replace all variables. Commands and paths reference values with ${env:NAME}.",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                    "description": "Variable name, unique ignoring case."
                  },
                  "label": {
                    "type": "string",
                    "description": "Display label; may be empty."
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "input",
                      "checkbox",
                      "select"
                    ]
                  },
                  "defaultValue": {
                    "type": [
                      "string",
                      "boolean"
                    ],
                    "description": "Boolean for checkbox; string for input or select. Select defaults must match an option value."
                  },
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Required for select variables. Values must be unique and non-empty; labels must be non-empty.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "value",
                        "label"
                      ]
                    }
                  }
                },
                "required": [
                  "name",
                  "label",
                  "type",
                  "defaultValue"
                ],
                "oneOf": [
                  {
                    "properties": {
                      "type": {
                        "enum": [
                          "input"
                        ]
                      },
                      "defaultValue": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "properties": {
                      "type": {
                        "enum": [
                          "checkbox"
                        ]
                      },
                      "defaultValue": {
                        "type": "boolean"
                      }
                    }
                  },
                  {
                    "properties": {
                      "type": {
                        "enum": [
                          "select"
                        ]
                      },
                      "defaultValue": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "options"
                    ]
                  }
                ]
              }
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "description": "Workflow steps, executed in order.",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "local-command",
                      "ssh-command",
                      "sftp"
                    ],
                    "description": "Step type."
                  },
                  "command": {
                    "type": "string",
                    "description": "Shell command for local-command and ssh-command steps. local-command steps support placeholders such as ${workspaceFolder}."
                  },
                  "cwd": {
                    "type": "string",
                    "description": "Optional working directory for local-command steps. Supports placeholders such as ${workspaceFolder}. Defaults to the first workspace folder."
                  },
                  "assetId": {
                    "type": "string",
                    "description": "SSH asset ID or unique ID prefix for ssh-command and sftp steps."
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "upload",
                      "download"
                    ],
                    "description": "Transfer direction for sftp steps."
                  },
                  "localPath": {
                    "type": "string",
                    "description": "Local file path for sftp steps. Supports placeholders such as ${workspaceFolder}."
                  },
                  "remotePath": {
                    "type": "string",
                    "description": "Remote file path for sftp steps."
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          },
          "required": [
            "name",
            "steps"
          ]
        }
      }
    ],
