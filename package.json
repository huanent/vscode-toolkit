{
  "name": "toolkit",
  "displayName": "Toolkit",
  "version": "2.0.0",
  "description": "Developer utilities for VS Code",
  "categories": [
    "Other"
  ],
  "homepage": "https://github.com/huanent/vscode-toolkit.git",
  "license": "MIT",
  "repository": {
    "type": "github",
    "url": "https://github.com/huanent/vscode-toolkit"
  },
  "publisher": "huanent",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run validate && npm run build:production",
    "compile": "npm run validate && VITE_BUILD_TARGET=extension vite build --mode development && VITE_BUILD_TARGET=webview vite build --mode development",
    "build:production": "VITE_BUILD_TARGET=extension vite build --mode production && VITE_BUILD_TARGET=webview vite build --mode production",
    "package": "mkdir -p packages && vsce package --out packages/toolkit-$npm_package_version.vsix",
    "format": "oxfmt .",
    "check-types": "npm run check-types:host && npm run check-types:webview",
    "check-types:host": "tsc --noEmit -p tsconfig.host.json",
    "check-types:webview": "tsc --noEmit -p tsconfig.webview.json",
    "lint": "oxlint src",
    "validate": "npm run check-types && npm run lint"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.125.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/vsce": "^4.0.0",
    "cn": "^0.4.0",
    "exceljs": "^4.4.0",
    "mysql2": "^3.24.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "xml-formatter": "^3.7.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "contributes": {
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ],
        "mimetypes": [
          "message/http",
          "application/http"
        ],
        "firstLine": "^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|CONNECT|TRACE)\\s+(.*?)HTTP/[0-9\\.]+$",
        "configuration": "./languages/http-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "http",
        "scopeName": "source.http",
        "path": "./syntaxes/http.tmLanguage.json",
        "embeddedLanguages": {
          "source.json": "json",
          "text.xml": "xml"
        }
      }
    ],
    "snippets": [
      {
        "language": "http",
        "path": "./snippets/http.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "toolkit.archiveEditor",
        "displayName": "Archive",
        "selector": [
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.vsix"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.spreadsheetEditor",
        "displayName": "Spreadsheet",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.sqliteEditor",
        "displayName": "SQLite Database",
        "selector": [
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.sqlite"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.sqliteTableEditor",
        "displayName": "SQLite Table",
        "selector": [
          {
            "filenamePattern": "*.sqlite-table"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.mysqlEditor",
        "displayName": "MySQL Database",
        "selector": [
          {
            "filenamePattern": "*.mysql"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.mysqlTableEditor",
        "displayName": "MySQL Table",
        "selector": [
          {
            "filenamePattern": "*.mysql-table"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.workflowEditor",
        "displayName": "Workflow",
        "selector": [
          {
            "filenamePattern": "*.workflow"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "toolkit_dashboard",
          "title": "Toolkit",
          "icon": "resource/logo.svg"
        }
      ],
      "panel": [
        {
          "id": "toolkit_result",
          "title": "Result",
          "icon": "$(run-with-deps)"
        }
      ]
    },
    "views": {
      "toolkit_dashboard": [
        {
          "type": "webview",
          "id": "toolkit.dashboard",
          "name": "Toolkit",
          "icon": "resource/logo.svg"
        }
      ],
      "toolkit_result": [
        {
          "type": "webview",
          "id": "toolkit.result",
          "name": "Result",
          "icon": "$(run-with-deps)"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "assetsSearch",
        "displayName": "Search Assets",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "assetsSearch",
        "modelDescription": "Search configured Toolkit assets by keyword. Returns matching asset IDs and non-secret connection metadata.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "keyword": {
              "type": "string",
              "description": "Keyword to match against asset names, IDs, types, folders, hosts, ports, and database names."
            }
          },
          "required": [
            "keyword"
          ]
        }
      },
      {
        "name": "sshExecute",
        "displayName": "Run SSH Command",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sshExecute",
        "modelDescription": "Run a command on an SSH asset by its ID. Requires user confirmation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "SSH asset ID."
            },
            "command": {
              "type": "string",
              "description": "Remote shell command to execute."
            }
          },
          "required": [
            "id",
            "command"
          ]
        }
      },
      {
        "name": "sftpTransfer",
        "displayName": "Transfer SFTP File",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sftpTransfer",
        "modelDescription": "Upload or download a file through an SSH asset by its ID. Requires user confirmation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "SSH asset ID."
            },
            "direction": {
              "type": "string",
              "enum": [
                "upload",
                "download"
              ],
              "description": "Transfer direction."
            },
            "localPath": {
              "type": "string",
              "description": "Absolute local file path."
            },
            "remotePath": {
              "type": "string",
              "description": "Remote file path."
            }
          },
          "required": [
            "id",
            "direction",
            "localPath",
            "remotePath"
          ]
        }
      },
      {
        "name": "sqlExecute",
        "displayName": "Execute SQL",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "sqlExecute",
        "modelDescription": "Execute one SQL statement against a database asset by its ID. Requires user confirmation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Database asset ID."
            },
            "database": {
              "type": "string",
              "description": "Optional database name; defaults to the asset's configured database."
            },
            "sql": {
              "type": "string",
              "description": "Single SQL statement to execute."
            }
          },
          "required": [
            "id",
            "sql"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "toolkit.assets.add",
        "title": "New Asset",
        "category": "Assets"
      },
      {
        "command": "toolkit.assets.createFolder",
        "title": "New Folder",
        "category": "Assets"
      },
      {
        "command": "toolkit.assets.move",
        "title": "Move to Folder",
        "category": "Assets"
      },
      {
        "command": "toolkit.assets.rename",
        "title": "Rename",
        "category": "Assets"
      },
      {
        "command": "toolkit.assets.edit",
        "title": "Edit",
        "category": "Assets"
      },
      {
        "command": "toolkit.assets.delete",
        "title": "Delete",
        "category": "Assets"
      },
      {
        "command": "toolkit.assets.copyHost",
        "title": "Copy Host",
        "category": "Assets"
      },
      {
        "command": "toolkit.assets.query",
        "title": "Run SQL Query",
        "category": "Assets"
      },
      {
        "command": "toolkit.credential.manage",
        "title": "Manage Credentials",
        "icon": "$(key)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.credential.add",
        "title": "Add Credential",
        "icon": "$(add)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.generateGitignore",
        "title": "Generate .gitignore",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runDotnetScript",
        "title": "Run dotnet Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runShScript",
        "title": "Run sh Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runBatScript",
        "title": "Run bat Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runNodeScript",
        "title": "Run node Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runBunScript",
        "title": "Run bun Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runNpmScript",
        "title": "Run package.json Script",
        "icon": "$(terminal)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runBunPackageScript",
        "title": "Run package.json Script",
        "icon": "$(terminal)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.pullGitRepository",
        "title": "Pull",
        "icon": "$(cloud-download)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.pushGitRepository",
        "title": "Push",
        "icon": "$(cloud-upload)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.fetchGitRepository",
        "title": "Fetch",
        "icon": "$(sync)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.checkoutGitRepository",
        "title": "Checkout to...",
        "icon": "$(git-branch)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.archive.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)",
        "category": "Archive"
      },
      {
        "command": "toolkit.dashboard.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)",
        "category": "Dashboard"
      },
      {
        "command": "toolkit.dashboard.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Dashboard"
      },
      {
        "command": "toolkit.temp.createFile",
        "title": "New File",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.workflow.createFile",
        "title": "New Workflow",
        "category": "Workflow"
      },
      {
        "command": "toolkit.workflow.createFolder",
        "title": "New Folder",
        "category": "Workflow"
      },
      {
        "command": "toolkit.temp.createFolder",
        "title": "New Folder",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.temp.rename",
        "title": "Rename",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.workflow.edit",
        "title": "Edit",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.workflow.rename",
        "title": "Rename",
        "category": "Workflow"
      },
      {
        "command": "toolkit.temp.delete",
        "title": "Delete",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.temp.move",
        "title": "Move to Folder",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.workflow.delete",
        "title": "Delete",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.workflow.move",
        "title": "Move to Folder",
        "category": "Workflow"
      },
      {
        "command": "toolkit.http.sendRequest",
        "title": "Send HTTP Request",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.sqlite.executeQuery",
        "title": "Run SQLite Query",
        "icon": "$(play)",
        "category": "SQLite"
      },
      {
        "command": "toolkit.sqlite.openSqlEditor",
        "title": "Open SQL Editor",
        "icon": "$(code)",
        "category": "SQLite"
      },
      {
        "command": "toolkit.mysql.executeQuery",
        "title": "Run MySQL Query",
        "icon": "$(play)",
        "category": "MySQL"
      },
      {
        "command": "toolkit.mysql.openSqlEditor",
        "title": "Open SQL Editor",
        "icon": "$(code)",
        "category": "MySQL"
      },
      {
        "command": "toolkit.mysql.openTable",
        "title": "Open MySQL Table",
        "category": "MySQL"
      }
    ],
    "keybindings": [
      {
        "command": "toolkit.sqlite.executeQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "toolkit.sqliteQueryEditor"
      },
      {
        "command": "toolkit.mysql.executeQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "toolkit.mysqlQueryEditor"
      }
    ],
    "submenus": [
      {
        "id": "toolkit.sourceControl",
        "label": "Source Control"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "toolkit.dashboard.refresh",
          "when": "view == toolkit.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "toolkit.dashboard.collapseAll",
          "when": "view == toolkit.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "toolkit.credential.manage",
          "when": "view == toolkit.dashboard",
          "group": "1_more"
        }
      ],
      "editor/title": [
        {
          "command": "toolkit.http.sendRequest",
          "when": "editorLangId == http",
          "group": "navigation@1"
        },
        {
          "command": "toolkit.archive.collapseAll",
          "when": "activeCustomEditorId == toolkit.archiveEditor",
          "group": "navigation@2"
        },
        {
          "command": "toolkit.sqlite.executeQuery",
          "when": "editorLangId == sql && toolkit.sqliteQueryEditor",
          "group": "navigation@3"
        },
        {
          "command": "toolkit.mysql.executeQuery",
          "when": "editorLangId == sql && toolkit.mysqlQueryEditor",
          "group": "navigation@3"
        },
        {
          "command": "toolkit.credential.add",
          "when": "activeWebviewPanelId == toolkit.credential",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "toolkit.http.sendRequest",
          "when": "editorLangId == http",
          "group": "navigation@1"
        },
        {
          "command": "toolkit.sqlite.executeQuery",
          "when": "editorLangId == sql && toolkit.sqliteQueryEditor",
          "group": "navigation@2"
        },
        {
          "command": "toolkit.mysql.executeQuery",
          "when": "editorLangId == sql && toolkit.mysqlQueryEditor",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "toolkit.dashboard.refresh",
          "when": "false"
        },
        {
          "command": "toolkit.dashboard.collapseAll",
          "when": "false"
        },
        {
          "command": "toolkit.assets.edit",
          "when": "false"
        },
        {
          "command": "toolkit.assets.delete",
          "when": "false"
        },
        {
          "command": "toolkit.assets.rename",
          "when": "false"
        },
        {
          "command": "toolkit.assets.query",
          "when": "false"
        },
        {
          "command": "toolkit.temp.rename",
          "when": "false"
        },
        {
          "command": "toolkit.workflow.edit",
          "when": "false"
        },
        {
          "command": "toolkit.temp.delete",
          "when": "false"
        },
        {
          "command": "toolkit.workflow.delete",
          "when": "false"
        },
        {
          "command": "toolkit.workflow.rename",
          "when": "false"
        },
        {
          "command": "toolkit.workflow.createFolder",
          "when": "false"
        },
        {
          "command": "toolkit.assets.move",
          "when": "false"
        },
        {
          "command": "toolkit.temp.move",
          "when": "false"
        },
        {
          "command": "toolkit.workflow.move",
          "when": "false"
        },
        {
          "command": "toolkit.sqlite.executeQuery",
          "when": "toolkit.sqliteQueryEditor"
        },
        {
          "command": "toolkit.mysql.executeQuery",
          "when": "toolkit.mysqlQueryEditor"
        },
        {
          "command": "toolkit.mysql.openTable",
          "when": "false"
        },
        {
          "command": "toolkit.credential.add",
          "when": "false"
        },
        {
          "command": "toolkit.sqlite.openSqlEditor",
          "when": "activeCustomEditorId == toolkit.sqliteEditor"
        },
        {
          "command": "toolkit.runNodeScript",
          "when": "toolkit.nodeAvailable && !toolkit.bunWorkspace"
        },
        {
          "command": "toolkit.runBunScript",
          "when": "toolkit.bunAvailable && toolkit.bunWorkspace"
        },
        {
          "command": "toolkit.runNpmScript",
          "when": "false"
        },
        {
          "command": "toolkit.runBunPackageScript",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "toolkit.assets.createFolder",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'assets'",
          "group": "1_create@2"
        },
        {
          "command": "toolkit.assets.add",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'assets'",
          "group": "1_create@1"
        },
        {
          "command": "toolkit.assets.query",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'assets' && assetId && assetType == mysql",
          "group": "2_actions@5"
        },
        {
          "command": "toolkit.assets.copyHost",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'assets' && assetId && assetHost",
          "group": "2_actions@4"
        },
        {
          "command": "toolkit.assets.edit",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'assets' && assetId && !assetDatabase",
          "group": "2_actions@1"
        },
        {
          "command": "toolkit.assets.delete",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'assets' && assetId && !assetDatabase",
          "group": "9_delete@1"
        },
        {
          "command": "toolkit.assets.move",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'assets' && (assetId || assetFolderPath)",
          "group": "2_actions@3"
        },
        {
          "command": "toolkit.assets.rename",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'assets' && assetFolderPath && !assetId",
          "group": "2_actions@2"
        },
        {
          "command": "toolkit.assets.delete",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'assets' && assetFolderPath && !assetId",
          "group": "9_delete@1"
        },
        {
          "command": "toolkit.temp.createFile",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'temp'",
          "group": "1_create@1"
        },
        {
          "command": "toolkit.temp.createFolder",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'temp'",
          "group": "1_create@2"
        },
        {
          "command": "toolkit.temp.rename",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'temp' && tempEntryPath",
          "group": "2_actions@1"
        },
        {
          "command": "toolkit.temp.delete",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'temp' && tempEntryPath",
          "group": "9_delete@1"
        },
        {
          "command": "toolkit.temp.move",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'temp' && tempEntryPath",
          "group": "2_actions@2"
        },
        {
          "command": "toolkit.workflow.createFile",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'workflow'",
          "group": "1_create@1"
        },
        {
          "command": "toolkit.workflow.createFolder",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'workflow'",
          "group": "1_create@2"
        },
        {
          "command": "toolkit.workflow.edit",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'workflow' && workflowId",
          "group": "2_actions@1"
        },
        {
          "command": "toolkit.workflow.rename",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'workflow' && (workflowId || workflowFolderId)",
          "group": "2_actions@2"
        },
        {
          "command": "toolkit.workflow.delete",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'workflow' && (workflowId || workflowFolderId)",
          "group": "9_delete@1"
        },
        {
          "command": "toolkit.workflow.move",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'workflow' && (workflowId || workflowFolderId)",
          "group": "2_actions@3"
        }
      ],
      "explorer/context": [
        {
          "submenu": "toolkit.sourceControl",
          "when": "explorerResourceIsFolder && resourcePath in toolkit.gitRepositoryFolders",
          "group": "navigation@9"
        },
        {
          "command": "toolkit.runDotnetScript",
          "when": "resourceExtname == .cs",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runShScript",
          "when": "resourceExtname == .sh && !isWindows",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runBatScript",
          "when": "resourceExtname == .bat && isWindows",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runNodeScript",
          "when": "(resourceLangId == javascript || resourceLangId == typescript) && toolkit.nodeAvailable && !toolkit.bunWorkspace",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runBunScript",
          "when": "(resourceLangId == javascript || resourceLangId == typescript) && toolkit.bunAvailable && toolkit.bunWorkspace",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runNpmScript",
          "when": "explorerResourceIsFolder && toolkit.npmAvailable && resourcePath in toolkit.npmScriptFolders",
          "group": "navigation@12"
        },
        {
          "command": "toolkit.runBunPackageScript",
          "when": "explorerResourceIsFolder && toolkit.bunAvailable && resourcePath in toolkit.bunScriptFolders",
          "group": "navigation@12"
        }
      ],
      "toolkit.sourceControl": [
        {
          "command": "toolkit.pullGitRepository",
          "group": "1_remote@1"
        },
        {
          "command": "toolkit.pushGitRepository",
          "group": "1_remote@2"
        },
        {
          "command": "toolkit.fetchGitRepository",
          "group": "1_remote@3"
        },
        {
          "command": "toolkit.checkoutGitRepository",
          "group": "2_local@1"
        }
      ]
    },
    "configuration": {
      "title": "Toolkit",
      "properties": {
        "toolkit.perftips.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show debug interval annotations while debugging. Changes apply to new debug sessions.",
          "scope": "window"
        },
        "toolkit.storagePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Toolkit data directory. Supports `~`. Defaults to extension global storage.",
          "scope": "machine"
        }
      }
    }
  },
  "activationEvents": [
    "onDebugAdapterProtocolTracker",
    "onFileSystem:toolkit-temp",
    "onLanguageModelTool:assetsSearch",
    "onLanguageModelTool:sftpTransfer",
    "onLanguageModelTool:sqlExecute",
    "onLanguageModelTool:sshExecute",
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "icon": "resource/logo.png",
  "engines": {
    "vscode": "^1.125.0"
  }
}
