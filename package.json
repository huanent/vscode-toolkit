{
  "name": "toolkit",
  "displayName": "Toolkit",
  "version": "1.8.10",
  "description": "Developer utilities for VS Code",
  "categories": [
    "Other"
  ],
  "homepage": "https://github.com/huanent/vscode-toolkit.git",
  "license": "MIT",
  "repository": {
    "type": "github",
    "url": "https://github.com/huanent/vscode-toolkit"
  },
  "publisher": "huanent",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run validate && npm run build:production",
    "compile": "npm run validate && VITE_BUILD_TARGET=extension vite build --mode development && VITE_BUILD_TARGET=webview vite build --mode development",
    "build:production": "VITE_BUILD_TARGET=extension vite build --mode production && VITE_BUILD_TARGET=webview vite build --mode production",
    "package": "mkdir -p packages && vsce package --out packages/toolkit-$npm_package_version.vsix",
    "format": "oxfmt .",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "validate": "npm run check-types && npm run lint && npm run format"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@vscode/codicons": "^0.0.46-24",
    "cn": "^0.4.0",
    "exceljs": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xml-formatter": "^3.7.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.125.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/debugprotocol": "^1.68.0",
    "@vscode/vsce": "^4.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "contributes": {
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ],
        "mimetypes": [
          "message/http",
          "application/http"
        ],
        "firstLine": "^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS|CONNECT|TRACE)\\s+(.*?)HTTP/[0-9\\.]+$",
        "configuration": "./languages/http-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "http",
        "scopeName": "source.http",
        "path": "./syntaxes/http.tmLanguage.json",
        "embeddedLanguages": {
          "source.json": "json",
          "text.xml": "xml"
        }
      }
    ],
    "snippets": [
      {
        "language": "http",
        "path": "./snippets/http.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "toolkit.archiveEditor",
        "displayName": "Archive",
        "selector": [
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.vsix"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.spreadsheetEditor",
        "displayName": "Spreadsheet",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.sqliteEditor",
        "displayName": "SQLite Database",
        "selector": [
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.sqlite"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "toolkit.sqliteTableEditor",
        "displayName": "SQLite Table",
        "selector": [
          {
            "filenamePattern": "*.sqlite-table"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "toolkit_dashboard",
          "title": "Toolkit",
          "icon": "$(developer-tools)"
        }
      ],
      "panel": [
        {
          "id": "toolkit_result",
          "title": "Result",
          "icon": "$(run-with-deps)"
        }
      ]
    },
    "views": {
      "toolkit_dashboard": [
        {
          "type": "webview",
          "id": "toolkit.dashboard",
          "name": "Toolkit",
          "icon": "$(developer-tools)"
        }
      ],
      "toolkit_result": [
        {
          "type": "webview",
          "id": "toolkit.result",
          "name": "Result",
          "icon": "$(run-with-deps)"
        }
      ]
    },
    "commands": [
      {
        "command": "toolkit.generateGitignore",
        "title": "Generate .gitignore",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runDotnetScript",
        "title": "Run dotnet Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runShScript",
        "title": "Run sh Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runBatScript",
        "title": "Run bat Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runNodeScript",
        "title": "Run node Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runBunScript",
        "title": "Run bun Script",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runNpmScript",
        "title": "Run package.json Script",
        "icon": "$(terminal)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.runBunPackageScript",
        "title": "Run package.json Script",
        "icon": "$(terminal)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.pullGitRepository",
        "title": "Pull",
        "icon": "$(cloud-download)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.pushGitRepository",
        "title": "Push",
        "icon": "$(cloud-upload)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.fetchGitRepository",
        "title": "Fetch",
        "icon": "$(sync)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.checkoutGitRepository",
        "title": "Checkout to...",
        "icon": "$(git-branch)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.archive.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)",
        "category": "Archive"
      },
      {
        "command": "toolkit.temp.createFile",
        "title": "New File",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.temp.createFolder",
        "title": "New Folder",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.temp.rename",
        "title": "Rename",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.temp.delete",
        "title": "Delete",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.http.sendRequest",
        "title": "Send HTTP Request",
        "icon": "$(play)",
        "category": "Toolkit"
      },
      {
        "command": "toolkit.sqlite.executeQuery",
        "title": "Run SQLite Query",
        "icon": "$(play)",
        "category": "SQLite"
      },
      {
        "command": "toolkit.sqlite.openSqlEditor",
        "title": "Open SQL Editor",
        "icon": "$(code)",
        "category": "SQLite"
      }
    ],
    "keybindings": [
      {
        "command": "toolkit.sqlite.executeQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "toolkit.sqliteQueryEditor"
      }
    ],
    "submenus": [
      {
        "id": "toolkit.sourceControl",
        "label": "Source Control"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "toolkit.http.sendRequest",
          "when": "editorLangId == http",
          "group": "navigation@1"
        },
        {
          "command": "toolkit.archive.collapseAll",
          "when": "activeCustomEditorId == toolkit.archiveEditor",
          "group": "navigation@2"
        },
        {
          "command": "toolkit.sqlite.executeQuery",
          "when": "editorLangId == sql && toolkit.sqliteQueryEditor",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "toolkit.http.sendRequest",
          "when": "editorLangId == http",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "toolkit.temp.rename",
          "when": "false"
        },
        {
          "command": "toolkit.temp.delete",
          "when": "false"
        },
        {
          "command": "toolkit.sqlite.executeQuery",
          "when": "toolkit.sqliteQueryEditor"
        },
        {
          "command": "toolkit.sqlite.openSqlEditor",
          "when": "activeCustomEditorId == toolkit.sqliteEditor"
        },
        {
          "command": "toolkit.runNodeScript",
          "when": "toolkit.nodeAvailable && !toolkit.bunWorkspace"
        },
        {
          "command": "toolkit.runBunScript",
          "when": "toolkit.bunAvailable && toolkit.bunWorkspace"
        },
        {
          "command": "toolkit.runNpmScript",
          "when": "false"
        },
        {
          "command": "toolkit.runBunPackageScript",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "toolkit.temp.createFile",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'temp'",
          "group": "1_create@1"
        },
        {
          "command": "toolkit.temp.createFolder",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'temp'",
          "group": "1_create@2"
        },
        {
          "command": "toolkit.temp.rename",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'temp' && tempEntryPath",
          "group": "2_edit@1"
        },
        {
          "command": "toolkit.temp.delete",
          "when": "webviewId == 'toolkit.dashboard' && webviewSection == 'temp' && tempEntryPath",
          "group": "2_edit@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "toolkit.sourceControl",
          "when": "explorerResourceIsFolder && resourcePath in toolkit.gitRepositoryFolders",
          "group": "navigation@9"
        },
        {
          "command": "toolkit.runDotnetScript",
          "when": "resourceExtname == .cs",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runShScript",
          "when": "resourceExtname == .sh && !isWindows",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runBatScript",
          "when": "resourceExtname == .bat && isWindows",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runNodeScript",
          "when": "(resourceLangId == javascript || resourceLangId == typescript) && toolkit.nodeAvailable && !toolkit.bunWorkspace",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runBunScript",
          "when": "(resourceLangId == javascript || resourceLangId == typescript) && toolkit.bunAvailable && toolkit.bunWorkspace",
          "group": "navigation@10"
        },
        {
          "command": "toolkit.runNpmScript",
          "when": "explorerResourceIsFolder && toolkit.npmAvailable && resourcePath in toolkit.npmScriptFolders",
          "group": "navigation@12"
        },
        {
          "command": "toolkit.runBunPackageScript",
          "when": "explorerResourceIsFolder && toolkit.bunAvailable && resourcePath in toolkit.bunScriptFolders",
          "group": "navigation@12"
        }
      ],
      "toolkit.sourceControl": [
        {
          "command": "toolkit.pullGitRepository",
          "group": "1_remote@1"
        },
        {
          "command": "toolkit.pushGitRepository",
          "group": "1_remote@2"
        },
        {
          "command": "toolkit.fetchGitRepository",
          "group": "1_remote@3"
        },
        {
          "command": "toolkit.checkoutGitRepository",
          "group": "2_local@1"
        }
      ]
    },
    "configuration": {
      "title": "Toolkit",
      "properties": {
        "toolkit.perftips.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show debug interval annotations while debugging. Changes apply to new debug sessions.",
          "scope": "window"
        },
        "toolkit.storagePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Toolkit data directory. Supports `~`. Defaults to extension global storage.",
          "scope": "machine"
        }
      }
    }
  },
  "activationEvents": [
    "onDebugAdapterProtocolTracker",
    "onFileSystem:toolkit-temp",
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "icon": "resource/logo.png",
  "engines": {
    "vscode": "^1.125.0"
  }
}
