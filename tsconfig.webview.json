{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "composite": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["src/webview/**/*.ts", "src/webview/**/*.tsx", "src/shared/**/*.ts"]
}
